      "id": "***",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following candidate resume and return a structured resume profile.\n\nRESUME:\n{{ $json.text }}\n\nExtract:\n1. candidate_name\n2. email\n3. education\n4. technical_skills (array)\n5. work_experience\n6. projects\n7. certifications\n8. key_strengths (array)\n9. weak_skills (array)\n10. suitable_job_roles (array, ranked by best fit first)\n\nRules:\n- Use only information found in the resume.\n- Do not invent information.\n- If information is not available, write \"Not mentioned\".\n- Return ONLY the structured JSON, nothing else.",
        "hasOutputParser": true,
        "needsFallback": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        4704,
        3840
      ],
      "id": "***",
      "name": "AI Agent - Resume Analyzer"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        4704,
        4048
      ],
      "id": "***",
      "name": "Google Gemini Chat Model - Resume Fallback",
      "credentials": {
        "googlePalmApi": {
          "id": "***",
          "name": "***"
        }
