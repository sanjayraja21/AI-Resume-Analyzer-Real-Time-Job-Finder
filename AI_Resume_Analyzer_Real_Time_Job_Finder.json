{
  "name": "AI Resume Analyzer + Real-Time Job Finder",
  "nodes": [
    {
      "parameters": {
        "formTitle": "AI Resume Analyzer + Real-Time Job Finder",
        "formDescription": "To automate the complete process of resume analysis → job matching → real-time vacancy search → job ranking → Gmail notification using an AI agent and n8n workflows.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
