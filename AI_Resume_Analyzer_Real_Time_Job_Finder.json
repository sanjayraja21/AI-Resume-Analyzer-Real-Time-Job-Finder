    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Split Out Jobs').item.json;\nreturn {\n  json: {\n    title: original.title,\n    company_name: original.company_name,\n    candidate_required_location: original.candidate_required_location,\n    url: original.url,\n    output: $json.output\n  }\n};"
      },
