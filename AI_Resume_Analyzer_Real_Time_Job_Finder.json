      "typeVersion": 3,
      "position": [
        5440,
        3504
      ],
      "id": "***",
      "name": "Loop Over Jobs"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Compare this candidate profile against the job listing below and score the match.\n\nCANDIDATE PROFILE:\n{{ JSON.stringify($('AI Agent - Resume Analyzer').item.json.output) }}\n\nJOB LISTING:\nTitle: {{ $json.title }}\nCompany: {{ $json.company_name }}\nLocation: {{ $json.candidate_required_location }}\nDescription: {{ $json.description }}\nSalary: {{ $json.salary }}\n\nReturn:\n1. match_score (0-100)\n2. match_summary (1-2 sentences)\n3. matching_skills (array)\n4. missing_skills (array)\n\nReturn ONLY the structured JSON, nothing else.",
        "hasOutputParser": true,
        "needsFallback": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        5632,
        3424
