    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"candidate_name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"education\": \"B.Tech in AI & DS\",\n  \"technical_skills\": [\"Python\", \"SQL\", \"n8n\"],\n  \"work_experience\": \"Not mentioned\",\n  \"projects\": \"Resume analyzer bot\",\n  \"certifications\": \"Not mentioned\",\n  \"key_strengths\": [\"Machine Learning\", \"Data Analysis\"],\n  \"weak_skills\": [\"Cloud Deployment\"],\n  \"suitable_job_roles\": [\"AI Engineer\", \"Data Analyst\"]\n}"
      },
