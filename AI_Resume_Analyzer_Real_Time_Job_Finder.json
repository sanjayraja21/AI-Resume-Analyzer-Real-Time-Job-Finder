    {
      "parameters": {
        "jsCode": "const jobs = items[0].json.topJobs || [];\n\nconst rows = jobs.map((j) => {\n  const job = j.json ? j.json : j;\n  const jobInfo = job.output ? job : { output: {} };\n  const listing = job;\n  return `\n    <tr>\n      <td style=\"padding:8px;border:1px solid #ddd;\">${listing.title || 'Untitled role'}</td>\n      <td style=\"padding:8px;border:1px solid #ddd;\">${listing.company_name || 'N/A'}</td>\n      <td style=\"padding:8px;border:1px solid #ddd;\">${listing.candidate_required_location || 'Remote'}</td>\n      <td style=\"padding:8px;border:1px solid #ddd;\">${jobInfo.output.match_score ?? 'N/A'}</td>\n      <td style=\"padding:8px;border:1px solid #ddd;\">${jobInfo.output.match_summary ?? ''}</td>\n      <td style=\"padding:8px;border:1px solid #ddd;\"><a href=\"${listing.url || '#'}\">Apply</a></td>\n    </tr>`;\n}).join('');\n\nconst html = `\n  <h2>Your Job Matches</h2>\n  <table style=\"border-collapse:collapse;width:100%;\">\n    <tr style=\"background:#f2f2f2;\">\n      <th style=\"padding:8px;border:1px solid #ddd;\">Title</th>\n      <th style=\"padding:8px;border:1px solid #ddd;\">Company</th>\n      <th style=\"padding:8px;border:1px solid #ddd;\">Location</th>\n      <th style=\"padding:8px;border:1px solid #ddd;\">Match %</th>\n      <th style=\"padding:8px;border:1px solid #ddd;\">Why it fits</th>\n      <th style=\"padding:8px;border:1px solid #ddd;\">Link</th>\n    </tr>\n    ${rows}\n  </table>`;\n\nreturn [{ json: { emailHtml: html } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6416,
        3840
      ],
